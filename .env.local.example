# Copy this file to .env.local and fill in your values

# Supabase — get from https://supabase.com/dashboard > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# AI model connections: seals each user's provider key at rest (AES-256-GCM).
# 32 random bytes as base64, so 44 characters ending in "=". Generate with:
#   node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value in Vercel Production and Preview (they share one database),
# and never rotate it in place: every key sealed under the old one becomes
# unreadable. Without it, connecting a model is unavailable; OpenClaw still works.
# Left blank, `./scripts/local-setup.sh dev` fills in a fresh one for local dev.
MODEL_KEYS_ENCRYPTION_KEY=

# Sign in with Apple revocation on account deletion (memory/plans/account-deletion.md).
# Leave unset locally: deletion then skips Apple. In Vercel, Production only:
# the Team ID, the Sign in with Apple key's ID and the whole .p8 file's text
# (Sensitive), and the iPhone app's bundle ID. The server signs its own
# five-minute client secret from the key, so nothing here needs rotating.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_IOS_CLIENT_ID=app.dsul.ios

# Bug reporting (optional)
# KIRBY_USER_ID=your-supabase-user-uuid-here

# PWA Push Notifications — VAPID keys
# Generate new keys with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
# Also add these to Vercel env vars (Settings > Environment Variables)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
