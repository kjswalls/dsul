{
  "name": "@dsul/openclaw-context",
  "version": "0.3.0",
  "description": "OpenClaw plugin for dsul — chat with your agent from dsul's Ask, and wake it the moment you hand it an item. Planner tools come from dsul's MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "dsul",
    "tasks",
    "productivity",
    "neurodivergent"
  ],
  "author": "Kirby Walls",
  "license": "MIT",
  "homepage": "https://github.com/kjswalls/dsul",
  "repository": {
    "type": "git",
    "url": "https://github.com/kjswalls/dsul.git",
    "directory": "openclaw-plugin"
  },
  "bugs": {
    "url": "https://github.com/kjswalls/dsul/issues"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "devDependencies": {
    "openclaw": "*",
    "typescript": "^5.4.0"
  }
}
