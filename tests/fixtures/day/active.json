{
  "isPausedOn": [
    {
      "name": "no pausedAt",
      "date": "2026-08-15",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "pausedUntil alone pauses nothing",
      "pausedUntil": "2026-09-01",
      "date": "2026-08-15",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "empty pausedAt",
      "pausedAt": "",
      "date": "2026-08-15",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "open-ended, on its first day",
      "pausedAt": "2026-08-10T12:00:00Z",
      "date": "2026-08-10",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "open-ended, the day before",
      "pausedAt": "2026-08-10T12:00:00Z",
      "date": "2026-08-09",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "open-ended, months later",
      "pausedAt": "2026-08-10T12:00:00Z",
      "date": "2027-01-01",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "until is exclusive, the day before it",
      "pausedAt": "2026-08-10T12:00:00Z",
      "pausedUntil": "2026-09-01",
      "date": "2026-08-31",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "until is exclusive, on it",
      "pausedAt": "2026-08-10T12:00:00Z",
      "pausedUntil": "2026-09-01",
      "date": "2026-09-01",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "until is exclusive, after it",
      "pausedAt": "2026-08-10T12:00:00Z",
      "pausedUntil": "2026-09-02",
      "date": "2026-09-03",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "a timestamp until reads as its day",
      "pausedAt": "2026-08-10T12:00:00Z",
      "pausedUntil": "2026-09-01T00:00:00Z",
      "date": "2026-09-01",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "a timestamp until, the day before",
      "pausedAt": "2026-08-10T12:00:00Z",
      "pausedUntil": "2026-09-01T00:00:00Z",
      "date": "2026-08-31",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "until before the start ends it at once",
      "pausedAt": "2026-08-10T12:00:00Z",
      "pausedUntil": "2026-08-05",
      "date": "2026-08-10",
      "timeZone": "America/New_York",
      "expected": false
    },
    {
      "name": "microseconds and +00:00, that day in LA",
      "pausedAt": "2026-09-30T14:03:22.123456+00:00",
      "date": "2026-09-30",
      "timeZone": "America/Los_Angeles",
      "expected": true
    },
    {
      "name": "microseconds and +00:00, the day before in LA",
      "pausedAt": "2026-09-30T14:03:22.123456+00:00",
      "date": "2026-09-29",
      "timeZone": "America/Los_Angeles",
      "expected": false
    },
    {
      "name": "whole seconds and +00:00, NY is still the day before",
      "pausedAt": "2026-08-10T00:00:00+00:00",
      "date": "2026-08-09",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "one fractional digit and Z",
      "pausedAt": "2026-09-30T23:30:00.5Z",
      "date": "2026-09-30",
      "timeZone": "UTC",
      "expected": true
    },
    {
      "name": "one fractional digit and Z, Tokyo is a day on",
      "pausedAt": "2026-09-30T23:30:00.5Z",
      "date": "2026-09-30",
      "timeZone": "Asia/Tokyo",
      "expected": false
    },
    {
      "name": "milliseconds at the last instant, UTC",
      "pausedAt": "2026-08-10T23:59:59.999Z",
      "date": "2026-08-10",
      "timeZone": "UTC",
      "expected": true
    },
    {
      "name": "milliseconds at the last instant, Tokyo",
      "pausedAt": "2026-08-10T23:59:59.999Z",
      "date": "2026-08-10",
      "timeZone": "Asia/Tokyo",
      "expected": false
    },
    {
      "name": "+05:30 offset, read in UTC",
      "pausedAt": "2026-08-11T03:00:00+05:30",
      "date": "2026-08-10",
      "timeZone": "UTC",
      "expected": true
    },
    {
      "name": "+05:30 offset, read in Kolkata",
      "pausedAt": "2026-08-11T03:00:00+05:30",
      "date": "2026-08-10",
      "timeZone": "Asia/Kolkata",
      "expected": false
    },
    {
      "name": "-07:00 offset, read in UTC",
      "pausedAt": "2026-08-10T20:00:00-07:00",
      "date": "2026-08-10",
      "timeZone": "UTC",
      "expected": false
    },
    {
      "name": "-07:00 offset, read in LA",
      "pausedAt": "2026-08-10T20:00:00-07:00",
      "date": "2026-08-10",
      "timeZone": "America/Los_Angeles",
      "expected": true
    },
    {
      "name": "crosses midnight: still the 10th in NY",
      "pausedAt": "2026-08-11T01:00:00Z",
      "date": "2026-08-10",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "crosses midnight: already the 11th in Berlin",
      "pausedAt": "2026-08-11T01:00:00Z",
      "date": "2026-08-10",
      "timeZone": "Europe/Berlin",
      "expected": false
    },
    {
      "name": "a bare date is UTC midnight, so NY starts the day before",
      "pausedAt": "2026-08-10",
      "date": "2026-08-09",
      "timeZone": "America/New_York",
      "expected": true
    },
    {
      "name": "junk pausedAt pauses nothing",
      "pausedAt": "not a date",
      "date": "2026-08-15",
      "timeZone": "America/New_York",
      "expected": false
    }
  ],
