      "name": "the same pause read in UTC has not begun",
      "current": {
        "pausedAt": "2026-10-03T02:00:00Z"
      },
      "req": {
        "paused": false
      },
      "todayStr": "2026-10-02",
      "nowIso": "2026-10-02T15:00:00.000Z",
