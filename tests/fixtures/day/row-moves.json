{
  "nextDayTarget": [
    {
      "name": "a row on today goes to tomorrow",
      "rowDateStr": "2026-10-02",
      "todayStr": "2026-10-02",
      "expected": "2026-10-03"
    },
    {
      "name": "a future row goes to its next day",
      "rowDateStr": "2026-10-08",
      "todayStr": "2026-10-02",
      "expected": "2026-10-09"
    },
    {
      "name": "an overdue row goes to real tomorrow, not its next day",
      "rowDateStr": "2026-09-28",
      "todayStr": "2026-10-02",
      "expected": "2026-10-03"
    },
    {
      "name": "month end",
      "rowDateStr": "2026-10-31",
      "todayStr": "2026-10-31",
      "expected": "2026-11-01"
    },
    {
      "name": "year end",
      "rowDateStr": "2026-12-31",
      "todayStr": "2026-12-30",
      "expected": "2027-01-01"
    },
    {
      "name": "into a leap day",
      "rowDateStr": "2028-02-28",
      "todayStr": "2028-02-28",
      "expected": "2028-02-29"
    },
    {
      "name": "past February in a common year",
      "rowDateStr": "2027-02-28",
      "todayStr": "2027-02-01",
      "expected": "2027-03-01"
    },
    {
      "name": "across a DST change",
      "rowDateStr": "2026-11-01",
      "todayStr": "2026-11-01",
      "expected": "2026-11-02"
    }
  ],
