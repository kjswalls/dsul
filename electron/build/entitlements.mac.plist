<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Signed builds only (electron-builder.config.cjs). JIT is all V8 needs under the hardened
  runtime. electron-builder's default template also grants allow-unsigned-executable-memory and
  disable-library-validation, which undo much of what notarization buys; add the first back only
  if a signed build crashes without it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
